{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "test",
      "type": "shell",
      "command": "make",
      "args": ["test", "FILTER='${input:testFilter}'"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "test:samples",
      "type": "shell",
      "command": "make",
      "args": ["test-samples", "INCLUDE='${input:includeFilter}'"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "test:integration:txt",
      "type": "shell",
      "command": "make",
      "args": [
        "test-integration-txt",
        "SOURCE='${input:integrationSampleSource}'",
        "COUNT='${input:integrationSampleCount}'"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "test:integration:s3",
      "type": "shell",
      "command": "make",
      "args": [
        "test-integration-s3",
        "SOURCE='${input:integrationSampleSource}'",
        "COUNT='${input:integrationSampleCount}'"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "test:integration:llm",
      "type": "shell",
      "command": "make",
      "args": [
        "test-integration-llm",
        "SOURCE='${input:integrationSampleSource}'",
        "COUNT='${input:integrationSampleCount}'"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "INTEGRATION_LLM_PROFILES": ""
        }
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "download:samples",
      "type": "shell",
      "command": "make",
      "args": [
        "download-samples",
        "MIME='${input:downloadMimeType}'",
        "N='${input:downloadDocCount}'"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "docker:run",
      "type": "shell",
      "command": "make",
      "args": ["docker-run", "PROFILE='${input:dockerRunProfile}'"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "dev",
      "type": "shell",
      "command": "make",
      "args": ["dev"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "api:dev",
      "type": "shell",
      "command": "make",
      "args": ["api-dev"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "test:api",
      "type": "shell",
      "command": "make",
      "args": ["test-api"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "test:integration:api",
      "type": "shell",
      "command": "make",
      "args": ["test-integration-api"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "docker:build",
      "type": "shell",
      "command": "make",
      "args": ["docker-build", "TARGET='${input:dockerBuildTarget}'"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "fallow",
      "type": "shell",
      "command": "make",
      "args": ["fallow"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "make",
      "args": ["lint"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "skylos",
      "type": "shell",
      "command": "make",
      "args": ["skylos"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "install",
      "type": "shell",
      "command": "make",
      "args": ["install"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "purge",
      "type": "shell",
      "command": "make",
      "args": ["purge"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "release",
      "type": "shell",
      "command": "make",
      "args": ["release", "VERSION='${input:releaseVersion}'"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "testFilter",
      "type": "promptString",
      "description": "Test name filter (e.g. 'pipeline') — default * = all",
      "default": "*"
    },
    {
      "id": "includeFilter",
      "type": "promptString",
      "description": "File filter (e.g. 'docx', 'pdf', '*.html') — default * = all",
      "default": "*"
    },
    {
      "id": "integrationSampleCount",
      "type": "promptString",
      "description": "Sample file count for e2e jobs (tests/samples or .data/downloads). 0 or * = all.",
      "default": "5"
    },
    {
      "id": "integrationSampleSource",
      "type": "pickString",
      "description": "Sample source for integration tests.",
      "options": ["samples", "downloads"],
      "default": "samples"
    },
    {
      "id": "downloadMimeType",
      "type": "promptString",
      "description": "Mimetype or extension alias (e.g. pdf, docx, application/pdf). Comma-separated is supported.",
      "default": "pdf"
    },
    {
      "id": "downloadDocCount",
      "type": "promptString",
      "description": "Number of documents to download per mimetype.",
      "default": "5"
    },
    {
      "id": "releaseVersion",
      "type": "promptString",
      "description": "Version X.Y.Z, or leave empty for automatic patch bump (recommended in VS Code tasks).",
      "default": ""
    },
    {
      "id": "dockerBuildTarget",
      "type": "pickString",
      "description": "Docker image(s) to build (default images include API and both workers).",
      "options": ["all", "txt", "llm", "api"],
      "default": "all"
    },
    {
      "id": "dockerRunProfile",
      "type": "pickString",
      "description": "Compose stack: local disk (TXT+LLM+Ollama) or SeaweedFS S3 (same + SeaweedFS; compose files end with seaweedfs.yml).",
      "options": ["local", "s3"],
      "default": "local"
    }
  ]
}
